NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (keep service role key strictly on the backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-side OTP Pepper (generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
OTP_PEPPER=your-long-random-hex-string

# Gmail SMTP Delivery (Requires Google 2-Step Verification + App Password)
GMAIL_USER=yourapp@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
